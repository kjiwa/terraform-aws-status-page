{
  "name": "status-page-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "codegen": "json2ts ../../modules/status/lambda/status_payload.schema.json -o src/generated/status-payload.d.ts --bannerComment \"/* GENERATED by npm run codegen -- do not edit. */\" && json2ts ../../modules/status/lambda/status_series.schema.json -o src/generated/status-series.d.ts --cwd=../../modules/status/lambda --bannerComment \"/* GENERATED by npm run codegen -- do not edit. */\"",
    "dev": "vite",
    "build": "npm run codegen && vite build",
    "build:check": "npm run build && git diff --exit-code ../../modules/status/dist",
    "pretypecheck": "npm run codegen",
    "typecheck": "tsc --noEmit",
    "prelint": "npm run codegen",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.2",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "preact": "^11.0.1"
  }
}
